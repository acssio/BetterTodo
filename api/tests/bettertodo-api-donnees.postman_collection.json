{
  "info": {
    "name": "BetterTodo API – étape 2b (données)",
    "description": "Listes, groupes, tâches, tags, niveaux d'urgence, ordre et isolation entre utilisateurs. À lancer dans l'ordre (voir docs/etapes/02b-api-donnees.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    }
  ],
  "item": [
    {
      "name": "01 Compte A – inscription",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"motdepasse-test-123\",\n  \"display_name\": \"Testeur A\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('token', b.token);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('emailA', 'donnees-a-' + Date.now() + '@example.test');"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Compte B – inscription",
