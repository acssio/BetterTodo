      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Profil – nom vide",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"display_name\": \"   \"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Nouvelle liste sans vue → vue du compte",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/lists",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Liste de test\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('201 et default_view = sections', () => { pm.response.to.have.status(201); pm.expect(b.default_view).to.eql('sections'); });",
              "pm.collectionVariables.set('listTest', b.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Nouvelle liste avec vue explicite",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/lists",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Liste colonnes\",\n  \"default_view\": \"columns\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('la vue demandée gagne', () => pm.expect(pm.response.json().default_view).to.eql('columns'));"
            ]
          }
        }
      ]
    },
    {
