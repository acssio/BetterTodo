      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 : se déconnecter d\\'un appareil ne déconnecte pas les autres', () => pm.response.to.have.status(200));",
              "// Remet l'email à zéro pour la prochaine exécution",
              "pm.collectionVariables.unset('email');"
            ]
          }
        }
      ]
    }
  ]
