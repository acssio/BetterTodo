{
  "info": {
    "name": "BetterTodo API – comptes (étapes 2a et 3c-2)",
    "description": "Tests de bout en bout : santé, inscription, connexion, déconnexion. À lancer dans l'ordre (voir docs/etapes/02a-api-fondations.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "password",
      "value": "motdepasse-test-123"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Un email unique par exécution, pour pouvoir relancer la collection autant de fois que voulu",
          "if (!pm.collectionVariables.get('email')) {",
          "    pm.collectionVariables.set('email', 'test-' + Date.now() + '@example.test');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Santé",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 et status ok', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Profil – sans jeton",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Inscription",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"  {{email}} \",\n  \"password\": \"{{password}}\",\n  \"display_name\": \"Testeur\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('renvoie un jeton et l\\'utilisateur', () => {",
              "    pm.expect(body.token).to.be.a('string').and.have.lengthOf(43);",
              "    pm.expect(body.user.email).to.eql(pm.collectionVariables.get('email'));",
              "    pm.expect(body.user).to.not.have.property('password_hash');",
              "});",
              "pm.test('pose le cookie de session HttpOnly', () => {",
              "    const cookie = pm.response.headers.get('Set-Cookie');",
              "    pm.expect(cookie).to.include('bettertodo_session=');",
              "    pm.expect(cookie).to.include('HttpOnly');",
              "});",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Inscription – email déjà pris",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"display_name\": \"Doublon\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Inscription – mot de passe trop court",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"court-{{email}}\",\n  \"password\": \"1234\",\n  \"display_name\": \"Court\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 avec un message', () => {",
              "    pm.response.to.have.status(400);",
              "    pm.expect(pm.response.json().error).to.include('8 caractères');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Inscription – champ inconnu",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"x@example.test\",\n  \"pasword\": \"faute-de-frappe\",\n  \"display_name\": \"X\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 : le champ mal orthographié est signalé', () => {",
              "    pm.response.to.have.status(400);",
              "    pm.expect(pm.response.json().error).to.include('pasword');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Profil (jeton)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 et le bon utilisateur', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().display_name).to.eql('Testeur');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Profil – vue par défaut initiale",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('default_view = columns', () => pm.expect(pm.response.json().default_view).to.eql('columns'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Profil – modifier nom et vue par défaut",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"display_name\": \"  Testeur modifié \",\n  \"default_view\": \"sections\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('200, nom nettoyé, vue changée', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(b.display_name).to.eql('Testeur modifié');",
              "    pm.expect(b.default_view).to.eql('sections');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Profil – vue invalide",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/me",
        "header": [
          {
            "key": "Authorization",
