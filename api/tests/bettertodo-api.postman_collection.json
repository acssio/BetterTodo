      ]
    },
    {
      "name": "19 Profil – jeton inventé",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer jeton-invente"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "20 Connexion – mauvais mot de passe",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"mauvais-mot-de-passe\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 avec un message générique', () => {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(pm.response.json().error).to.eql('Email ou mot de passe incorrect');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "21 Connexion – email inconnu",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"inconnu@example.test\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 avec le MÊME message (on ne révèle pas quels emails existent)', () => {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(pm.response.json().error).to.eql('Email ou mot de passe incorrect');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Connexion – OK (2e session)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 et un nouveau jeton', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.token).to.not.eql(pm.collectionVariables.get('token'));",
              "});",
              "pm.collectionVariables.set('token2', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Déconnexion (2e session)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/logout",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token2}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "24 Profil – session fermée",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token2}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 : le jeton déconnecté ne marche plus', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "25 Profil – 1re session toujours valide",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
