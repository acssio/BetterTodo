        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));",
              "// Remet l'email à zéro pour la prochaine exécution",
              "pm.collectionVariables.unset('email');"
            ]
          }
        }
      ]
    }
  ]
}
