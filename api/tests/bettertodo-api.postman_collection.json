    {
      "name": "18 Son groupe par défaut s'appelle Tasks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/lists/{{listEn}}/board",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
