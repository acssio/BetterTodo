{
  "info": {
    "name": "BetterTodo API – comptes (étapes 2a, 3c-2, 3e et 3f)",
    "description": "Tests de bout en bout : santé, installation (premier compte admin), console admin, changement de mot de passe, connexion, déconnexion, profil. À lancer dans l'ordre avec --env-var adminEmail=… --env-var adminPassword=… (voir docs/etapes/03e-admin-et-icones.md et 03f-mot-de-passe.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "password",
      "value": "motdepasse-test-123"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Un email unique par exécution, pour pouvoir relancer la collection autant de fois que voulu",
          "if (!pm.collectionVariables.get('email')) {",
          "    pm.collectionVariables.set('email', 'test-' + Date.now() + '@example.test');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Santé",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 et status ok', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Profil – sans jeton",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Console admin – refusée sans jeton",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/users",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Avant toute connexion : Postman garde les cookies, un test « sans jeton » plus loin enverrait le cookie de session",
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Installation – état",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/setup",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 et needs_setup booléen', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.needs_setup).to.be.a('boolean');",
              "});",
              "pm.collectionVariables.set('needsSetup', String(body.needs_setup));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Installation – premier compte (admin)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/setup",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"display_name\": \"Admin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Base vide : crée l'admin (201). Sinon : déjà installé (403).",
              "if (pm.collectionVariables.get('needsSetup') === 'true') {",
              "    pm.test('201 : premier compte créé, admin', () => {",
              "        pm.response.to.have.status(201);",
              "        pm.expect(pm.response.json().user.is_admin).to.eql(true);",
              "    });",
              "} else {",
              "    pm.test('403 : déjà installé', () => pm.response.to.have.status(403));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Admin – connexion",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 (passer --env-var adminEmail=… --env-var adminPassword=…)', () => pm.response.to.have.status(200));",
              "pm.test('is_admin = true', () => pm.expect(pm.response.json().user.is_admin).to.eql(true));",
              "pm.test('l\\'admin de l\\'installation n\\'a pas à changer son mot de passe', () => pm.expect(pm.response.json().user.must_change_password).to.eql(false));",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Installation – refusée une fois faite",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/setup",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
