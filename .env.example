# Copier ce fichier en .env puis changer le mot de passe.
# Le fichier .env n'est jamais commité (voir .gitignore).

# --- Base de données ---
POSTGRES_DB=bettertodo
POSTGRES_USER=bettertodo
# Lettres et chiffres seulement : le mot de passe est mis dans une URL de connexion
POSTGRES_PASSWORD=change-moi

# --- Serveur API ---
# Durée de vie d'une connexion, en jours
SESSION_DAYS=30
# Mettre true dès que le site est servi en HTTPS
COOKIE_SECURE=false
